# Frontend environment. Copy to .env (gitignored).
#
# Vite loads .env automatically but inlines these values at BUILD time, so a
# bundle is pinned to whatever was set when `npm run build` ran. Only VITE_-
# prefixed names reach the browser, and they ship in the bundle — nothing
# secret belongs here.

# Base URL of the backend API, no trailing slash. Defaults to localhost:8000.
VITE_API_BASE=http://localhost:8000

# Google sign-in client ID, paired with the backend's GOOGLE_CLIENT_ID.
# Not read by any code yet — Google auth is a separate ticket.
VITE_GOOGLE_CLIENT_ID=
