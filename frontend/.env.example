# Frontend environment. Copy to `.env` — Vite loads it automatically.
# VITE_* values are inlined into the bundle at build time, so treat them as
# public. An OAuth client ID is designed to be public; a secret is not.

# The same client ID as the backend's GOOGLE_CLIENT_ID. See
# backend/.env.example for how to create it in the Google Cloud console.
# Left unset, the "Continue with Google" button is not rendered.
VITE_GOOGLE_CLIENT_ID=
