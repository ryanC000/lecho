# Backend environment. Copy to .env (gitignored); every value below has a
# working dev default, so an unset environment boots fine.
#
# Nothing loads this automatically — the backend reads plain env vars and takes
# no dotenv dependency. Point uvicorn at the file instead:
#
#   uvicorn api.main:app --reload --env-file .env

# Signs and verifies JWTs. Unset falls back to a public dev key and warns at
# startup — set a long random value before deploying.
JWT_SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# OAuth 2.0 Client ID for Google Sign-In. Create one yourself:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create credentials -> OAuth client ID -> Web application
#   3. Under "Authorised JavaScript origins" add http://localhost:5173
#      (the Vite dev origin). No redirect URI is needed: the app uses the
#      ID-token flow, where Google hands the browser a signed token and the
#      backend verifies it — there is no redirect back to the server.
#   4. Paste the client ID below AND into frontend/.env as VITE_GOOGLE_CLIENT_ID;
#      the two must match or verification fails on the audience claim.
# Left unset, POST /auth/google returns 503 and the frontend hides the button.
GOOGLE_CLIENT_ID=

# SQLAlchemy URL; Postgres in deploys.
DATABASE_URL=sqlite:///./lecho.db

# Where uploads and analysis artifacts live: LOCAL (backend/storage/) or S3.
STORAGE_BACKEND=LOCAL

# S3 settings, read only when STORAGE_BACKEND=S3.
S3_BUCKET=
AWS_REGION=
# Set for an S3-compatible server such as MinIO; empty means real AWS.
S3_ENDPOINT_URL=
# Optional key prefix, so one bucket can hold several environments (and so the
# test suite can isolate itself). Stored keys stay canonical — changing this
# never rewrites a row, it only changes where objects are addressed.
STORAGE_PREFIX=
# Read by boto3 itself. Unset on AWS, where the task role supplies them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# How a created job reaches the worker. INLINE scores it in-process after the
# response (dev + the test suite). SQS publishes the job id for a standalone
# worker container — `python -m worker.main` — to consume.
QUEUE_BACKEND=INLINE
# Read only when QUEUE_BACKEND=SQS. The queue needs a visibility timeout longer
# than a scoring run (300s) and a redrive policy to a DLQ; see k8s/README.md.
SQS_QUEUE_URL=

# How the content gate reaches faster-whisper. SUBPROCESS shells out to the
# quarantined `stt` conda env — right on the dev box, where there is no cp314
# wheel. INPROCESS imports it directly and is what every container must set:
# images have no conda, and the gate FAILS OPEN, so getting this wrong does not
# raise — it silently scores gibberish takes as valid.
CONTENT_GATE_BACKEND=SUBPROCESS
